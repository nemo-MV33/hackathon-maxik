BOT_TOKEN=replace_with_your_max_bot_token
API_ACCESS_KEY=replace_with_internal_api_key
PORT=3000
MINI_APP_URL=https://158-160-253-148.sslip.io
IRNITU_API_URL=https://schedule.istu.edu/api/
IRNITU_API_TOKEN=replace_with_irnitu_api_token
IRNITU_TIMEOUT_MS=6000
IRNITU_RETRIES=1
CACHE_DIR=./data/cache
INIT_DATA_MAX_AGE_SEC=86400
DEV_USER_ID=
# app — кнопка «Открыть приложение» открывает мини-приложение бота в MAX (нужен адрес в настройках бота на платформе MAX)
# link — обычная ссылка на MINI_APP_URL, без авторизации MAX: расписание работает, ДЗ — нет
MINI_APP_BUTTON=app

# Проверка изменений сегодня и завтра у активных групп, 15 минут
CHANGES_INTERVAL_MS=900000
# Проверка ближайших 14 дней, 3 часа
RECENT_CHANGES_INTERVAL_MS=10800000
# Возраст недели для фонового обновления по запросу, 15 минут
SCHEDULE_CACHE_TTL_MS=900000
# Общий предел запросов к API ИРНИТУ в процессе
IRNITU_CONCURRENCY=4
DIRECTORY_CACHE_TTL_MS=10800000
# Статическая выгрузка: ближайшие 2 недели каждые 3 часа, семестр раз в неделю
EXPORT_INTERVAL_SEC=10800
EXPORT_FULL_INTERVAL_SEC=604800
EXPORT_WEEKS=2
EXPORT_CONCURRENCY=4

# БГУ: публичный сайт, токен не нужен. Общая файловая очередь бота и выгрузки.
BGU_CACHE_DIR=./data/bgu-cache
# Минимальная пауза 1500 мс между запросами; параллельность всегда 1
BGU_REQUEST_DELAY_MS=1500

# СПбПУ: открытый API ruz.spbstu.ru, ключ не нужен
SPBPU_CACHE_DIR=./data/spbpu-cache
# СПбГУ: открытый API с суточной квотой на IP, поэтому расписание обновляется раз в час
SPBU_CACHE_DIR=./data/spbu-cache
SPBU_SCHEDULE_TTL_MS=3600000

# Вложения ДЗ: отдельный постоянный том Docker, без публичной статической раздачи
ATTACHMENT_DIR=./attachments
# Размер одного файла, 10 МиБ
ATTACHMENT_MAX_BYTES=10485760
# Вложения в одном ДЗ и несохранённые загрузки одного автора
ATTACHMENT_MAX_COUNT=8
# Все файлы группы, включая историю, личные версии и несохранённые загрузки, 100 МиБ
ATTACHMENT_GROUP_BYTES=104857600
# Свободное место, которое нельзя занимать вложениями, 512 МиБ
ATTACHMENT_RESERVE_BYTES=536870912
# Общий бюджет вложений ВМ, 5 ГиБ; оставляет место для копии релиза
ATTACHMENT_TOTAL_BYTES=5368709120

# Этап 4: закрытая группа ДЕМО-25-1 в настоящем MAX. Пустой список скрывает её от всех.
# Порядок: староста, студент, затем редакторы. Только числовые MAX user_id, через запятую.
DEMO_MAX_IDS=
# Отдельный закрытый чат; все его участники должны входить в список выше.
DEMO_CHAT_ID=

# Резервные копии: ресурсы создаются только по отдельному разрешению владельца.
BACKUP_BUCKET=
BACKUP_PREFIX=norfly/
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
# 32 случайных байта в hex, файл 600; внешний экземпляр ключа хранить отдельно от ВМ и бакета.
# Путь внутри служебного контейнера; на хосте /etc/norfly-backup/key.
BACKUP_KEY_FILE=/backup-secrets/key
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_STATUS_FILE=/backup/last-backup.json
# Администратор предварительно запускает бота; при ошибке копии получает личное сообщение MAX.
BACKUP_ADMIN_ID=
